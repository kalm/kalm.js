{
  "name": "kalm",
  "version": "9.0.0",
  "description": "The socket optimizer",
  "type": "module",
  "main": "dist/kalm.js",
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.mjs",
    "clean": "rm -rf ./dist/*",
    "test": "node --experimental-strip-types --test tests/**/*.spec.ts",
    "prepublishOnly": "npm run build && cp ../../LICENSE ./LICENSE"
  },
  "engines": {
    "node": ">=22"
  },
  "funding": {
    "type": "Open Collective",
    "url": "https://opencollective.com/kalm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalm/kalm-js.git"
  },
  "keywords": [
    "framework",
    "network",
    "realtime",
    "socket",
    "nagle",
    "ipc",
    "tcp",
    "udp",
    "websocket",
    "webrtc",
    "peer"
  ],
  "files": [
    "dist",
    "types.d.ts"
  ],
  "typings": "./types.d.ts",
  "author": "frederic charette <fredericcharette@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kalm/kalm-js/issues"
  },
  "homepage": "https://kalm.js.org",
  "contributors": [
    "frederic charette <fredericcharette@gmail.com>"
  ]
}
